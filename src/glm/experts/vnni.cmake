# Optional Q8_K activation approximation, independent of exact F32 experts.
# Include after ggml-base; no global ISA flags and no AVX512VBMI requirement.
if(NOT TARGET ggml-base)
  message(FATAL_ERROR "GLM VNNI experts require ggml-base")
endif()
add_library(strata_glm_experts_vnni STATIC ${CMAKE_CURRENT_LIST_DIR}/iq4_vnni.cpp)
target_compile_features(strata_glm_experts_vnni PUBLIC cxx_std_17)
target_include_directories(strata_glm_experts_vnni PUBLIC
  ${CMAKE_CURRENT_LIST_DIR} ${CMAKE_CURRENT_LIST_DIR}/../../../include
  PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../../../third_party/ggml)
target_link_libraries(strata_glm_experts_vnni PUBLIC ggml-base)
add_executable(glm_vnni_parity ${CMAKE_CURRENT_LIST_DIR}/vnni_parity.cpp)
target_include_directories(glm_vnni_parity PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../../../third_party/ggml)
target_link_libraries(glm_vnni_parity PRIVATE strata_glm_experts_vnni)
if(TARGET ggml-cpu)
  target_link_libraries(glm_vnni_parity PRIVATE ggml-cpu)
  target_compile_definitions(glm_vnni_parity PRIVATE STRATA_VNNI_GGML_DOT=1)
endif()
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(strata_glm_experts_vnni PRIVATE -ffp-contract=off)
  target_compile_options(glm_vnni_parity PRIVATE -ffp-contract=off)
endif()
if(BUILD_TESTING)
  add_test(NAME glm_vnni_quantized_parity COMMAND glm_vnni_parity --quick)
endif()
add_executable(glm_vnni_multi_bench ${CMAKE_CURRENT_LIST_DIR}/vnni_multi_bench.cpp)
target_include_directories(glm_vnni_multi_bench PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../../../third_party/ggml)
target_link_libraries(glm_vnni_multi_bench PRIVATE strata_glm_experts_vnni)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(glm_vnni_multi_bench PRIVATE -ffp-contract=off)
endif()
